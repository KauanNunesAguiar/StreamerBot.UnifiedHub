<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="defaultconfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Core\Assets\SharedStyles.css" />
    <EmbeddedResource Include="Core\Assets\ChatSettingsStyles.css" />
    <EmbeddedResource Include="Integrations\Spotify\Assets\spotify-login.html" />
    <EmbeddedResource Include="Integrations\Spotify\Assets\spotify-settings.html" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="EmbedIO" Version="3.5.2" />
    <PackageReference Include="RazorLight" Version="2.3.1" />
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SpotifyAPI.Web" Version="7.4.2" />
    <Compile Remove="Program.Example.cs" />
    <None Include="Program.Example.cs" />
  </ItemGroup>

  <Target Name="CopyTestProgramAsExample" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="..\StreamerBot.UnifiedHub.TestApp\Program.cs" 
          DestinationFiles="Program.Example.cs" 
          SkipUnchangedFiles="true" />
  </Target>
</Project>
